rules_version = '2';

// Each user can read and write only their own library:
//   users/{uid}/books/{workKey} and users/{uid}/logs/{logId}
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{collection}/{documentId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && collection in ['books', 'logs'];
    }
  }
}
